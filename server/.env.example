PORT=5000

MONGO_URI=mongodb://localhost:27017/credcheck

CLIENT_URL=http://localhost:5173

JWT_SECRET=changeme123

GOOGLE_CLIENT_ID=your_google_client_id_here

CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# --- Email (Brevo) ---
# Sender email must be verified in your Brevo account
EMAIL_FROM=your_verified_sender_email

# Brevo API v3 key (starts with "xkeysib-") - used with the HTTP API
# OR Brevo SMTP relay key (starts with "xsmtpsib-") - used with SMTP relay
# Exactly one of BREVO_API_KEY / EMAIL_PASS is required.
# Recommendation: set BREVO_API_KEY to an "xkeysib-" key (HTTP API).
BREVO_API_KEY=your_brevo_api_key

# SMTP fallback settings (only used when BREVO_API_KEY is an "xsmtpsib-" key)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
# EMAIL_USER for Brevo SMTP = the SMTP Username from Brevo (format: bxxxxxx@smtp-brevo.com)
EMAIL_USER=your_smtp_username
# EMAIL_PASS = the xsmtpsib- SMTP relay key from Brevo
EMAIL_PASS=